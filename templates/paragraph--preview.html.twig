{#
/**
 * @file
 * Override of paragraph.html.twig for preview mode
 * Renders the paragraph inside an iframe using the frontend theme for accurate preview.
 *
 * Available variables:
 * - paragraph_bundle: the machine name of the paragraph bundle
 * - paragraph_uuid: the paragraph uuid
 *
 * @see template_preprocess()
 * @see template_preprocess_paragraph__preview()
 *
 * @ingroup themeable
 */
#}
{{ attach_library('paragraphs_iframe_preview/paragraph_iframe_preview') }}

<div class="paragraph-iframe-preview {{ paragraph_bundle }}">
  <iframe src="{{ path('paragraphs_iframe_preview.paragraph_iframe_preview', {'paragraph_uuid' : paragraph_uuid }) }}"
          title="Preview of {{ paragraph_bundle }} paragraph"></iframe>
</div>
